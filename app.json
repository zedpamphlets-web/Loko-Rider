{
  "expo": {
    "name": "Loko Rider",
    "slug": "loko-rider",
    "owner": "matebeto2027s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lokorider",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.siximages.loko.rider",
      "buildNumber": "1",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#FFFFFF"
      }
    },
    "android": {
      "package": "com.siximages.loko.rider",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8A1C14"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Loko Rider to pick food and licence photos from your phone.",
          "cameraPermission": "Allow Loko Rider to take food, licence and rider photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Loko Rider to capture your rider photo inside the app.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "supabaseUrl": "https://lmyvvwulabezlglxjzvl.supabase.co",
      "supabaseAnonKey": "sb_publishable_XJVKUkLgF-0OJk2Mf4N8nQ_ZhmtezXu",
      "supabasePublishableKey": "sb_publishable_XJVKUkLgF-0OJk2Mf4N8nQ_ZhmtezXu",
      "paymentApiUrl": "https://lmyvvwulabezlglxjzvl.supabase.co/functions/v1"
    }
  }
}